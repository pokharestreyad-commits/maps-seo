# Groq AI Credentials (Required)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Google Maps Official API Key
GOOGLE_MAPS_API_KEY=

# Optional: Browserless Cloud Endpoint (for remote browser automation on Vercel/Netlify)
BROWSERLESS_WS_ENDPOINT=wss://chrome.browserless.io?token=your_token_here
